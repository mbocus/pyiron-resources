units      real
dimension  3
atom_style full

# create groups ###
group O type 2
group H type 1

## set charges - beside manually ###
set group O charge -0.9012059960
set group H charge 0.4505087957

### YAFF parameters ###
pair_style lj/cut/coul/long 10.0
bond_style  harmonic
bond_coeff  1 1186.71 0.96882
angle_style harmonic
angle_coeff 1 72.575 96.0066
kspace_style pppm 1.0e-5